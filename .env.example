# === MoneyClaw Configuration ===

# -- Telegram Bot --
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# -- LLM Providers (仅需配置 API Key，系统自动发现可用模型) --
# OpenAI (GPT-4o, GPT-4o-mini, etc.)
OPENAI_API_KEY=

# Anthropic (Claude 3 Opus/Sonnet/Haiku)
ANTHROPIC_API_KEY=

# DeepSeek (deepseek-chat, deepseek-reasoner)
DEEPSEEK_API_KEY=

# Groq (Llama, Mixtral 等高速模型)
GROQ_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Moonshot (月之暗面 / Kimi)
MOONSHOT_API_KEY=

# Ollama (本地模型，无需API Key)
OLLAMA_BASE_URL=http://localhost:11434

# -- 智能路由配置 --
# 每日LLM预算上限 (USD)，达到后自动降级到最便宜模型
DAILY_LLM_BUDGET=5.0

# 预算警告阈值 (0.0-1.0)，超过此比例进入谨慎模式
BUDGET_CAUTION_THRESHOLD=0.6

# 是否启用自动降级
ENABLE_AUTO_DOWNGRADE=true

# -- Trading mode --
# true  = simulate every order locally (nothing is sent to any broker)  ← start here
# false = send real orders to Alpaca (paper or live, see ALPACA_PAPER)
EXCHANGE_DRY_RUN=true

# -- Alpaca (US stocks/ETFs, dollar-based fractional orders) --
# Keys: https://app.alpaca.markets → (Paper) API Keys. Paper and live keys are different.
# MoneyClaw only uses trading + account/position read endpoints; it never moves money.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = paper-api.alpaca.markets (fake money), false = real money
ALPACA_PAPER=true

# -- Risk Limits (defaults sized for a $50 budget) --
RISK_MAX_TRADE_AMOUNT=20.0
RISK_MAX_DAILY_LOSS=20.0
RISK_APPROVAL_THRESHOLD=15.0
# Never deploy more than this across all open positions, even in a larger account
RISK_MAX_PORTFOLIO_BUDGET=50.0

# -- Crypto (disabled by default; strategies have enabled: false in config.yaml) --
EXCHANGE_BINANCE_API_KEY=
EXCHANGE_BINANCE_SECRET=

# -- Database --
# DB_PATH=./data/moneyclaw.db

# -- Web Dashboard --
# WEB_PORT=8080
# WEB_HOST=0.0.0.0
